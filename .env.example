# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CROP_AI_DEVICE=auto

# Model - keep mock until a validated checkpoint is available
MODEL_MODE=mock
MODEL_PATH=artifacts/models/best_model.pt
MODEL_ARCH=efficientnet_b0
MODEL_LABELS_PATH=artifacts/models/labels.json
CONFIDENCE_THRESHOLD=0.65

# Computer vision
CV_PREPROCESSING_MODE=standard
SEVERITY_MODE=heuristic
# Operational research bands only; these are not agricultural standards.
SEVERITY_LOW_MAX=5
SEVERITY_MODERATE_MAX=20
SEVERITY_HIGH_MAX=40
MAX_UPLOAD_MB=10

# Retrieval and generation
RAG_ENABLED=false
RAG_COLLECTION=crop_disease_knowledge
RAG_INDEX_PATH=data/vectorstore/tfidf.joblib
RAG_TOP_K=4
LLM_PROVIDER=mock
# Generic provider aliases used by the Phase 2 provider factory.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/realtime/ws
