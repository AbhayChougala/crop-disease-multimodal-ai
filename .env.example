# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CROP_AI_DEVICE=auto

# Model - keep mock until a validated checkpoint is available
MODEL_MODE=mock
MODEL_PATH=artifacts/models/best_model.pt
MODEL_ARCH=efficientnet_b0
MODEL_LABELS_PATH=artifacts/models/labels.json
CONFIDENCE_THRESHOLD=0.65

# Computer vision
CV_PREPROCESSING_MODE=standard
SEVERITY_MODE=heuristic
# Operational research bands only; these are not agricultural standards.
SEVERITY_LOW_MAX=5
SEVERITY_MODERATE_MAX=20
SEVERITY_HIGH_MAX=40
MAX_UPLOAD_MB=10

# Retrieval and generation
RAG_ENABLED=false
RAG_COLLECTION=crop_disease_knowledge
RAG_INDEX_PATH=data/vectorstore/tfidf.joblib
RAG_RETRIEVER=tfidf
RAG_SEMANTIC_INDEX_PATH=data/vectorstore/semantic.faiss
RAG_SEMANTIC_METADATA_PATH=data/vectorstore/semantic.metadata.json
RAG_CHUNKS_PATH=data/vectorstore/chunks.json
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
RAG_STRICT_DIAGNOSIS_FILTERS=false
HYBRID_LEXICAL_WEIGHT=0.5
HYBRID_SEMANTIC_WEIGHT=0.5
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=mock
# Generic provider aliases used by the Phase 2 provider factory.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_RETENTION_DAYS=30
CHAT_DATABASE_PATH=artifacts/runtime/chat.sqlite3
REPORT_ENABLE_PDF=true

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/realtime/ws
